PORT=3000
# Dataset size and seed. Same seed + size always yields the same data.
SANDBOX_SEED=42
SANDBOX_SUBSCRIBERS=1000
# Set to false to hide /sandbox/ground-truth (labeled anomalies) from agents during demos.
EXPOSE_GROUND_TRUTH=true
# Append-only, hash-chained audit log (JSON Lines).
AUDIT_LOG_FILE=logs/audit.jsonl
